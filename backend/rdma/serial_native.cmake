# The pinned fork unconditionally includes MPI in QbbHelper, despite NS3_MPI=OFF.
# Compile a recorded build-directory copy with MPI branches guarded. RDMA packet,
# queue, congestion control and completion implementations remain the pinned files.
if(ENABLE_MPI)
  message(FATAL_ERROR "This RDMA integration requires serial ns-3")
endif()
set(native_p2p "${PROJECT_SOURCE_DIR}/src/point-to-point")
set(serial_dir "${CMAKE_BINARY_DIR}/moe-serial-native")
file(MAKE_DIRECTORY "${serial_dir}")
file(READ "${native_p2p}/helper/qbb-helper.cc" helper)
string(REPLACE "#include \"ns3/mpi-interface.h\"\n#include \"ns3/mpi-receiver.h\""
  "#ifdef NS3_MPI\n#include \"ns3/mpi-interface.h\"\n#include \"ns3/mpi-receiver.h\"\n#endif" helper "${helper}")
string(REPLACE "  if (MpiInterface::IsEnabled ())" "#ifdef NS3_MPI\n  if (MpiInterface::IsEnabled ())" helper "${helper}")
string(REPLACE "  if (useNormalChannel)" "#endif\n  if (useNormalChannel)" helper "${helper}")
string(REPLACE "      Ptr<MpiReceiver> mpiRecA" "#ifdef NS3_MPI\n      Ptr<MpiReceiver> mpiRecA" helper "${helper}")
string(REPLACE "      devB->AggregateObject (mpiRecB);" "      devB->AggregateObject (mpiRecB);\n#else\n      NS_FATAL_ERROR (\"Remote channel requires MPI\");\n#endif" helper "${helper}")
file(WRITE "${serial_dir}/qbb-helper.cc" "${helper}")
file(READ "${native_p2p}/model/qbb-remote-channel.cc" remote)
string(REPLACE "#include \"ns3/mpi-interface.h\"" "#ifdef NS3_MPI\n#include \"ns3/mpi-interface.h\"\n#endif" remote "${remote}")
file(WRITE "${serial_dir}/qbb-remote-channel.cc" "${remote}")
get_target_property(native_sources libpoint-to-point-obj SOURCES)
set(serial_sources)
foreach(source IN LISTS native_sources)
  if(source MATCHES "(^|/)helper/qbb-helper.cc$")
    list(APPEND serial_sources "${serial_dir}/qbb-helper.cc")
  elseif(source MATCHES "(^|/)model/qbb-remote-channel.cc$")
    list(APPEND serial_sources "${serial_dir}/qbb-remote-channel.cc")
  elseif(NOT source MATCHES "(^|/)model/point-to-point-remote-channel.cc$")
    list(APPEND serial_sources "${source}")
  endif()
endforeach()
set_property(TARGET libpoint-to-point-obj PROPERTY SOURCES "${serial_sources}")
target_include_directories(libpoint-to-point-obj PRIVATE "${native_p2p}/helper" "${native_p2p}/model")
