        "line": 150,
        "text": "        }"
      },
      {
        "line": 151,
        "text": ""
      },
      {
        "line": 152,
        "text": "        // World-team barriers may mix direct NVLink writes with GIN signals, so a system-scope"
      },
      {
        "line": 153,
        "text": "        // threadfence is required to make the NVLink writes visible before publishing the barrier"
      },
      {
        "line": 154,
        "text": "        if constexpr (std::is_same_v<team_t, ncclTeamTagWorld>)"
      },
      {
        "line": 155,
        "text": "            ptx::fence_acq_rel_sys();"
      },
      {
        "line": 156,
        "text": ""
      },
      {
        "line": 157,
        "text": "        // NOTES: we can not use `kNumSMs` to judge, as maybe only part of the SMs will call this function"
      },
      {
        "line": 158,
        "text": "        (gridDim.x > 1) ? cooperative_groups::this_grid().sync() : __syncthreads();"
      },
      {
        "line": 159,
        "text": "    }"
      },
      {
        "line": 160,
        "text": ""
      },
      {
        "line": 161,
        "text": "    if (sm_idx == 0) {"
      },
      {
        "line": 162,
        "text": "        // Use QP 0 to do barrier: signal slot `rank_idx` on every rank, then wait for every rank's slot"
      },
      {
        "line": 163,
        "text": "        const NCCLGin barrier_gin(nccl_dev_comm, gin.nccl_window, 0, NCCL_GIN_RESOURCE_SHARING_CTA);"
